# ---------------------------------------------------------------
# LA Motores e Bombas — variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo .env (ele está no .gitignore).
# ---------------------------------------------------------------

# Banco de dados
#  - Local (padrão): arquivo SQLite dentro de ./data
#  - Nuvem (Turso): libsql://SEU-BANCO.turso.io  + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/la-motores.db
DATABASE_AUTH_TOKEN=

# URL pública do site/sistema (usada em links de PDF e SEO).
# Também pode ser definida em Configurações → Empresa.
APP_URL=http://localhost:3000

# Aplica migrações do banco automaticamente ao iniciar (true/false)
AUTO_MIGRATE=true

# Sessões: expiram por inatividade e por tempo máximo
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Pasta dos backups gerados por "npm run db:backup"
BACKUP_DIR=backups
